# MariaDB
DB_ROOT_PASSWORD=test_root_password
DB_NAME=webapp_notes
DB_USER=webapp_notes
DB_PASSWORD=test_password

# Backend
# APP_KEY IS GENERATED WITH "docker compose run --rm backend php artisan key:generate --show"
# THE DEFAULT VALUE IS FOR Demo/local ONLY
# APP_KEY=base64:CBRMalCSV2zCUxL5VJzGXuC45NkgMBmXIJ4UxxoyGRo=
DB_DATABASE=webapp_notes
DB_USERNAME=webapp_notes
DB_PASSWORD=test_password
DB_HOST=webapp_db # points to the database address, in this case it's the container inside of the docker network

# Cloud deployment
VITE_BACKEND=http://webapp_backend:8000
APP_HOST=notes-midterm-stage.hatamoto.uk
ROUTER=webapp-midterm-dev